# Initial Hyperliquid settings. The process starts Off even when real mode is configured.
# Operator Save can apply validated session overrides without writing this file.
HL_COINS=BTC,ETH,SOL,DOGE,BNB
# true = testnet. Only the exact string false selects mainnet.
HL_TESTNET=true
# Optional custom transport endpoints. Leave blank for the selected network defaults.
# A blank HL_WS_URL derives ws(s)://<HL_API_URL>/ws.
HL_API_URL=
HL_WS_URL=
HL_RPC_URL=
# Optional authentication for a custom HTTP API only. Official Hyperliquid hosts reject keys.
# The key is not sent to WebSocket or SDK RPC traffic. Empty scheme sends it raw.
HL_API_KEY=
HL_API_KEY_HEADER=Authorization
HL_API_KEY_SCHEME=Bearer
# HTTP recovery polling runs only while the market WebSocket is disconnected.
HL_FALLBACK_POLL_MS=30000

# Decision and chart cadence. Chart refresh does not call Jev.
TICK_MS=30000
PRICE_MS=1000
# Order and decision context settings.
QUOTE_USD=40
QUOTE_INSIDE_TICKS=1
CLOSE_SLIPPAGE_BPS=5
BANKROLL_USD=200
HORIZON_BLOCKS=100
# Positive integer minutes for each new run. There is no unlimited mode.
RUN_DURATION_MINUTES=30

# Server wallet for the first coin. Other coin keys may use the gitignored
# .wallets.json or WALLETS_JSON={"sleeves":[{"coin":"ETH","privateKey":"0x..."}]}.
PRIVATE_KEY=
# Paper mode is the default. Set false only for explicitly confirmed real runs.
DRY_RUN=true

# mock (default) | jev
MODEL=mock
# openrouter | typesafe | gateway. If unset, configured keys select in that order.
JEV_PROVIDER=openrouter
JEV_MODEL_ID=
# Keep provider secrets empty in this committed template. fnox may inject them at runtime.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=

# Optional PostgreSQL decision history. Leave blank to disable durable history locally.
DATABASE_URL=
# Required when DATABASE_URL is set. Use at least 32 random bytes and keep it secret.
DECISION_OWNER_SECRET=

# Public read-only HTTP and SSE listener.
PORT=3000
# Private operator listener. It always binds 127.0.0.1 and must not be publicly proxied.
CONTROL_PORT=3002
# Exact local dashboard Origin and exact loopback Host accepted by operator control.
CONTROL_ORIGIN=http://localhost:3001
CONTROL_HOST=127.0.0.1:3002
