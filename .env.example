# Bun inference service only. Trading settings and wallets belong to the browser.
# mock is for local development only; production requires jev.
MODEL=mock
JEV_PROVIDER=openrouter
JEV_MODEL_ID=
# Leave provider secrets empty here. fnox can inject them at runtime.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=

PORT=3000
# Exact comma-separated dashboard origins, without trailing slashes or paths.
# Set NODE_ENV=production and explicit HTTPS origins in production.
WEB_ORIGINS=http://localhost:3001
INFERENCE_RATE_PER_MINUTE=300
INFERENCE_BURST=20
INFERENCE_CONCURRENCY=32
INFERENCE_DEADLINE_MS=4000
