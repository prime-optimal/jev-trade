# Base URL of the Jev Trade bot (no trailing slash).
# The app connects to $NEXT_PUBLIC_API_URL/events (SSE).
# Leave unset in local dev: the dashboard uses the page's own host on port 3000,
# so both http://localhost:3001 and http://<LAN IP>:3001 reach the local bot.
# NEXT_PUBLIC_API_URL=http://localhost:3000
