# Public read-only Bun API base URL, without a trailing slash.
# The dashboard connects to /events and /run. Leave unset for the page host on port 3000.
# NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional private operator API base URL, without a trailing slash.
# Localhost pages already default to http://127.0.0.1:3002.
# Set only for an explicitly protected local or SSH-forwarded loopback channel.
# This setting adds no authentication. Never point it at a public reverse proxy.
# NEXT_PUBLIC_OPERATOR_API_URL=http://127.0.0.1:3002
