# Public inference-only Bun API base URL, including http:// or https://.
# The browser posts address-free inference requests to /decide.
# Leave unset to use the page's origin with port 3000.
# NEXT_PUBLIC_API_URL=http://localhost:3000
#
# Wallet authorization, Hyperliquid connections, orders, and finite trading runs
# belong to the browser. There is no Next session proxy or server operator API.
# Never put wallet private keys or provider secrets in NEXT_PUBLIC_* variables.
